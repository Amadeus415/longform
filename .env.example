# Public HTTPS URL of your deployed Longform server (used for Google OAuth callbacks and CORS)
PUBLIC_URL=https://longform-app.fly.dev

# Random 32+ byte secret used to sign session/media tokens and encrypt per-user cookies at rest
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Sign in with Google (OAuth 2.0 + PKCE) ---
# Create an OAuth 2.0 Web Client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Private allowlist gate: comma-separated emails allowed to sign in.
# Keep this set while it's just you / invited friends.
ALLOWED_EMAILS=you@gmail.com

# Flip to "true" when you want anyone with a Google account to sign in and connect their own feeds.
ALLOW_PUBLIC_SIGNUP=false

# Optional: owner emails when ALLOW_PUBLIC_SIGNUP=true (defaults to ALLOWED_EMAILS)
# ADMIN_EMAILS=you@gmail.com

# Optional fallback passcode sign-in (leave empty if using Google sign-in only)
# APP_PASSWORD=

# --- Persistence (SQLite via Node 24 built-in node:sqlite) ---
DATABASE_PATH=/data/longform.db

# --- AI Educational Judge (Gemini) ---
# Server-owned canonical scoring shared safely across all users (cached in SQLite).
# Leave empty to run zero-key mode (followed channels + deterministic clickbait guard).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Global daily video scoring cap across all users + per-user daily quota (prevents runaway API costs or single-user drain).
# Sizing guide (with shared canonical caching across users):
#   ~100 users:  GEMINI_DAILY_BUDGET=2000   (~$0.05/day)
#   ~1,000 users: GEMINI_DAILY_BUDGET=10000 (~$0.25/day)
#   ~5,000 users: GEMINI_DAILY_BUDGET=25000 (~$0.65/day)
# GEMINI_DAILY_BUDGET=10000
# GEMINI_USER_DAILY_BUDGET=120
# Proxy IP trust mode for rate limiting:
#   "false" (default) = direct socket IP only (Fly.io & Vercel edge headers auto-trusted ONLY when FLY_APP_NAME / VERCEL is set)
#   "cloudflare"      = trust CF-Connecting-IP behind Cloudflare Tunnel/Proxy
#   "true"            = trust rightmost X-Forwarded-For / X-Real-IP behind Railway/Nginx/Caddy
# TRUST_PROXY=false

# --- YouTube Ingestion & Scale (Optional) ---
# Optional YouTube Data API v3 key: batches 50 video durations per 1 quota unit (recommended for 100s–1,000s of users)
# YOUTUBE_API_KEY=
# Outbound YouTube pacing & background crawler throughput
# YOUTUBE_MAX_CONCURRENT=6
# YOUTUBE_RPS=8
# CRAWLER_CHANNELS_PER_TICK=25

# --- Optional: Personal YouTube Home feed (private self-host only) ---
# Per-user cookies are AES-256-GCM encrypted at rest and disabled by default when ALLOW_PUBLIC_SIGNUP=true.
# ALLOW_USER_YOUTUBE_COOKIES=false
# YOUTUBE_COOKIE=
# COOKIE_ENCRYPTION_KEY=

# --- Optional: YouTube audio reliability on cloud datacenter IPs ---
# If YouTube ever challenges datacenter IPs on Listen mode, base64-encode a Netscape cookies.txt:
#   base64 -i cookies.txt | tr -d '\n'
# YTDLP_COOKIES_B64=
# YTDLP_PROXY=

# --- Optional: Mobile build default server URL ---
# Set when running `npm run build:mobile` so the iOS/Android app connects to your server automatically.
# VITE_API_URL=https://longform-app.fly.dev
